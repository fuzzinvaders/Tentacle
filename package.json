{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"build:mobile": "node scripts/build-mobile.mjs",
		"cap:sync": "cap sync android",
		"android:open": "cap open android",
		"android:release": "npm run build:mobile && npm run cap:sync && cd android && gradlew.bat bundleRelease"
	},
	"devDependencies": {
		"@capacitor/android": "^8.4.2",
		"@capacitor/cli": "^8.4.2",
		"@capacitor/core": "^8.4.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@capacitor/filesystem": "^8.1.2",
		"@capacitor/local-notifications": "^8.3.0",
		"@capgo/capacitor-media-session": "^8.0.29"
	}
}
