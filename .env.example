# Modèle de configuration de déploiement. Copie-le en `.env` (ignoré par git) à côté du
# fichier docker-compose que tu utilises : Docker Compose le lit automatiquement.
#
# Rien n'est codé en dur dans le dépôt : ni registre, ni domaine, ni secret.

# --- Image à déployer (obligatoire pour docker-compose.deploy.yml / .traefik.yml) ---
# L'image publiée par ta CI, ou toute autre image Tentacle.
TENTACLE_IMAGE=registre.exemple.fr/utilisateur/tentacle:latest

# --- Origine publique (OBLIGATOIRE derrière un reverse proxy) ---
# Sans elle, la connexion échoue : le POST est rejeté comme requête inter-sites.
ORIGIN=https://tentacle.exemple.fr

# --- Domaine, pour docker-compose.traefik.yml uniquement ---
DOMAIN=tentacle.exemple.fr

# --- Secret de signature des sessions (recommandé) ---
# Génère-le une fois : openssl rand -hex 32
# S'il est absent, un secret aléatoire est créé et conservé dans users.json ; le changer
# déconnecte tout le monde.
AUTH_SECRET=

# --- Jeton exigé pour créer le compte administrateur sur /setup (recommandé en public) ---
# Vide = le premier visiteur peut créer l'admin. À NE PAS laisser vide sur une instance
# exposée à Internet.
SETUP_TOKEN=

# --- Mode démonstration (optionnel) ---
# À 1, l'application propose d'emblée son catalogue de démonstration : utile pour une
# instance vitrine, où les visiteurs n'ont aucun serveur Jellyfin à connecter.
DEMO_MODE=0

# --- Instance Gitea, pour ci/act-runner-compose.yml uniquement ---
GITEA_INSTANCE_URL=https://gitea.exemple.fr
# Jeton d'enregistrement du runner (première inscription seulement).
RUNNER_TOKEN=
